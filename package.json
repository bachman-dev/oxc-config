{
  "name": "@bachman-dev/oxc-config",
  "version": "0.3.0",
  "description": "Oxc configurations for use in Bachman Dev projects",
  "homepage": "https://github.com/bachman-dev/oxc-config",
  "license": "MIT",
  "author": "Collin Bachman <collin.r68zdn9d@bachman.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bachman-dev/oxc-config"
  },
  "files": [
    "dist/**/*.{mjs,d.mts}"
  ],
  "type": "module",
  "exports": {
    "./oxfmt": "./dist/oxfmt/index.mjs",
    "./oxlint": "./dist/oxlint/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "all": "pnpm test && pnpm build && pnpm typecheck && pnpm build:docs && pnpm format && pnpm lint:fix",
    "build": "tsdown --config ./tsdown.config.ts",
    "build:docs": "node ./scripts/docs.ts && oxfmt --write --config oxfmt.config.ts ./src/oxfmt/README.md ./src/oxlint/README.md",
    "format": "oxfmt --write --config oxfmt.config.ts .",
    "format:check": "oxfmt --check --config oxfmt.config.ts .",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:fix": "oxlint --config oxlint.config.ts --fix .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "oxfmt": ">=0.68.0 <1",
    "oxlint": "^1.83.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
